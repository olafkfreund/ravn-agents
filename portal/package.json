{
  "name": "ravn-portal",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "fetch:openapi": "curl -sf ${VITE_API_PROXY:-http://127.0.0.1:8080}/openapi.json -o openapi.json",
    "gen:api": "openapi-typescript ./openapi.json -o ./src/api/schema.d.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.59.16",
    "@xyflow/react": "^12.11.0",
    "openapi-fetch": "^0.13.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0"
  },
  "devDependencies": {
    "@types/node": "^22.8.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "openapi-typescript": "^7.4.2",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
